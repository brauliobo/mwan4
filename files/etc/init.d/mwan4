#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright 2026 MOSSDeF, Stan Grishin (stangri@melmac.ca).
# Based on original mwan3 by Florian Eckert <fe@dev.tdt.de>

readonly PKG_VERSION='dev'

. "${IPKG_INSTROOT}/lib/functions.sh"

START=19
USE_PROCD=1

MWAN4_STATUS_DIR="/var/run/mwan4"

MWAN4_TRACKERS="$MWAN4_STATUS_DIR/trackers"

service_running() {
	[ -d "$MWAN4_STATUS_DIR" ]
}

# Written by the last successful setup or reload; absent until mwan4 has been applied once.
mwan4_applied() {
	[ -f "$MWAN4_TRACKERS" ]
}

# The signature only makes procd restart the trackers of an interface whose configuration changed.
start_tracker_family() {
	local interface="$1"
	local family="$2"
	local signature="$3"

	procd_open_instance "track_${interface}_${family}"
	procd_set_param command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4track.uc "$interface" "$family" "$signature"
	procd_set_param respawn
	procd_close_instance
}

start_trackers() {
	local interface family signature

	[ -f "$MWAN4_TRACKERS" ] || return 0
	while read -r interface family signature; do
		start_tracker_family "$interface" "$family" "$signature"
	done < "$MWAN4_TRACKERS"
}

start_rtmon() {
	procd_open_instance rtmon_ipv4
	procd_set_param command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4rtmon.uc ipv4
	procd_set_param respawn
	procd_close_instance

	# Check IPv6 support
	if command -v ip > /dev/null && ip -6 addr show > /dev/null 2>&1; then
		procd_open_instance rtmon_ipv6
		procd_set_param command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4rtmon.uc ipv6
		procd_set_param respawn
		procd_close_instance
	fi
}

# Applies the configuration to the running service. Held under the hotplug lock; a rejected configuration keeps
# the running state, and the instances declared below are then the ones that already run.
reload_running() {
	(
		procd_lock
		ucode -S -L /lib/mwan4 /lib/mwan4/init_reload.uc
	) || logger -t mwan4 -p daemon.err 'configuration rejected, keeping the running state'
}

# Starts mwan4; on a running service the same call applies the configuration without a teardown, and procd
# restarts only the instances whose command changed.
start_service() {
	if mwan4_applied; then
		reload_running
	else
		# Delegate nftables/routes/rules setup to ucode
		ucode -S -L /lib/mwan4 /lib/mwan4/init_setup.uc
	fi

	start_trackers
	start_rtmon
}

stop_service() {
	# Delegate teardown to ucode
	ucode -S -L /lib/mwan4 /lib/mwan4/init_teardown.uc
}

service_stopped() { procd_set_config_changed firewall; }

reload_service() {
	start
}

# A restart of a running service is a reload: only stop followed by start tears everything down.
restart() {
	if mwan4_applied; then
		reload "$@"
	else
		start "$@"
	fi
}

service_triggers() {
	procd_add_reload_trigger 'mwan4'
}
