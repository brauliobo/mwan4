'use strict';
// SPDX-License-Identifier: AGPL-3.0-or-later
// Copyright 2026 MOSSDeF, Stan Grishin (stangri@melmac.ca).
//
// dnsmasq integration for domain based rules: one nftset file per dnsmasq
// instance conf-dir, fed from rule `domain` lists.

import { readfile, writefile, unlink, popen } from 'fs';
import { cursor } from 'uci';

const CONF_NAME = 'mwan4.conf';

function shell_quote(s) {
	return "'" + replace('' + s, "'", "'\\''") + "'";
}

// Conf-dir of every dnsmasq instance, as generated by /etc/init.d/dnsmasq.
function confdirs() {
	let ctx = cursor();
	ctx.load('dhcp');

	let dirs = [];
	ctx.foreach('dhcp', 'dnsmasq', s => push(dirs, split(s.confdir || sprintf('/tmp/dnsmasq.%s.d', s['.name']), ',')[0]));
	return dirs;
}

// dnsmasq only honours the first nftset line of a domain, so specs of all rules
// sharing a domain are merged and domains with identical specs share a line.
function render(entries) {
	let specs = {};
	for (let e in entries)
		for (let d in e.domains)
			specs[d] = uniq([...(specs[d] || []), ...e.specs]);

	let lines = {};
	for (let d in keys(specs)) {
		let key = join(',', specs[d]);
		lines[key] = [...(lines[key] || []), d];
	}

	return join('', map(keys(lines), key => sprintf('nftset=/%s/%s\n', join('/', lines[key]), key)));
}

function write_if_changed(path, content) {
	let current = readfile(path);
	if (!length(content)) {
		if (current == null) return false;
		unlink(path);
		return true;
	}
	if (current == content) return false;
	writefile(path, content);
	return true;
}

// Domain rules fill nft sets through dnsmasq's nftset option (dnsmasq-full).
function nftset_supported() {
	let p = popen('dnsmasq --version 2>/dev/null', 'r');
	let version = p?.read('all') || '';
	p?.close();
	return index(version, ' nftset ') >= 0;
}

// True when any instance file changed (dnsmasq has to be restarted to read it).
// Without nftset support the file is never written: dnsmasq refuses to start on an unknown option.
function sync(entries) {
	let content = nftset_supported() ? render(entries) : '';
	let changed = false;
	for (let dir in confdirs())
		changed = write_if_changed(dir + '/' + CONF_NAME, content) || changed;
	return changed;
}

function restart() {
	system('/etc/init.d/dnsmasq running && /etc/init.d/dnsmasq restart >/dev/null 2>&1');
}

// Resolve every domain through the local dnsmasq in the background so the
// nft sets are populated without waiting for the first client lookup.
function prefetch(domains) {
	if (!length(domains)) return;
	system(sprintf('(n=0; until nslookup localhost 127.0.0.1 >/dev/null 2>&1 || [ $n -ge 20 ]; do n=$((n+1)); sleep 1; done; ' +
		'for d in %s; do nslookup "$d" 127.0.0.1 >/dev/null 2>&1; done) >/dev/null 2>&1 &', join(' ', map(domains, d => shell_quote(d)))));
}

export default {
	CONF_NAME,
	confdirs,
	render,
	sync,
	nftset_supported,
	restart,
	prefetch,
};
