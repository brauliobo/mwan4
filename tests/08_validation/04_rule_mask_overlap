-- Testcase --
import m from 'mwan4';
m.set_scriptname('test');
m.init();

let validation = m.validate_config();
print('valid: ' + validation.valid + '\n');
for (let e in validation.errors)
	print('error ' + e.code + ' ' + e.section + ': ' + e.message + '\n');
for (let w in validation.warnings)
	print('warning ' + w.code + ' ' + (w.section ?? '-') + ': ' + w.message + '\n');

let diagnostics = m.get_diagnostics({ section: 'connections' }).diagnostics.connections;
print('diagnostics: mask=' + diagnostics.rule_mask + ' capacity=' + diagnostics.rule_capacity + ' errors=' + length(diagnostics.errors) + ' warnings=' + length(diagnostics.warnings) + '\n');
-- End --

