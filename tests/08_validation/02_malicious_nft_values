-- Testcase --
import m from 'mwan4';

m.set_scriptname('test');
m.init();
m.update_iface_to_table();

m.nft_file('create', 'dynamic');
m.rebuild_iface_nftfile();
m.nft_file('install', 'dynamic');
let dynamic_out = global.mocklib.read_captured('/usr/share/nftables.d/ruleset-post/10-mwan4.nft') || '';

m.nft_file('create', 'rules');
m.set_user_rules();
m.nft_file('install', 'rules');
let rules_out = global.mocklib.read_captured('/usr/share/nftables.d/ruleset-post/11-mwan4-rules.nft') || '';
let out = dynamic_out + rules_out;

print('has_good_iface: ' + (index(dynamic_out, 'mwan4_iface_in_wan_ipv4') >= 0) + '\n');
print('has_bad_family: ' + (index(out, 'ipv4; nft flush ruleset') >= 0) + '\n');
print('has_good_rule: ' + (index(rules_out, 'comment "good_rule"') >= 0) + '\n');
print('has_bad_proto: ' + (index(out, 'tcp; counter accept') >= 0) + '\n');
print('has_bad_port: ' + (index(out, '443 } counter accept') >= 0) + '\n');
print('has_bad_ipset: ' + (index(out, 'bad;flush') >= 0) + '\n');
print('has_bad_strategy: ' + (index(out, 'good_strategy;flush') >= 0) + '\n');
print('has_loglevel_injection: ' + (index(out, 'notice;touch') >= 0) + '\n');
-- End --

