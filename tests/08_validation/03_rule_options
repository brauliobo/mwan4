-- Testcase --
import m from 'mwan4';
m.set_scriptname('test');
m.init();

print('mac good: ' + m.validate_mac('AA:bb:cc:dd:ee:ff') + '\n');
print('mac short: ' + m.validate_mac('aa:bb:cc:dd:ee') + '\n');
print('mac injection: ' + m.validate_mac('aa:bb:cc:dd:ee:ff;touch') + '\n');
print('dscp 1: ' + m.validate_dscp('1') + '\n');
print('dscp 63: ' + m.validate_dscp('63') + '\n');
print('dscp 0: ' + m.validate_dscp('0') + '\n');
print('dscp 64: ' + m.validate_dscp('64') + '\n');
print('dscp name: ' + m.validate_dscp('ef') + '\n');

let validation = m.validate_config();
print('valid: ' + validation.valid + '\n');
for (let e in validation.errors)
	print(e.code + ' ' + e.section + '\n');

m.update_iface_to_table();
m.nft_file('create', 'rules');
m.set_user_rules();
m.nft_file('install', 'rules');
let nft = global.mocklib.read_captured('/usr/share/nftables.d/ruleset-post/11-mwan4-rules.nft');
for (let line in split(nft, '\n'))
	if (index(line, 'comment') >= 0) print(replace(line, / counter name \S+ jump \S+/, ' ...') + '\n');
print('injection present: ' + (index(nft, 'counter accept') >= 0 || index(nft, 'flush') >= 0 || index(nft, 'touch') >= 0) + '\n');
-- End --

