-- Testcase --
import m from 'mwan4';
import stability from 'stability';
m.set_scriptname('test');
m.init();

let now = 1000000;
global.time = () => now;
let at = t => { now = 1000000 + t; };

let rpcd = require('rpcd_mwan4').mwan4;

stability.link_connected('wan', m.stability_opts('wan'), true, now);
at(100); m.set_iface_hotplug_state('wan', 'offline'); stability.link_disconnected('wan', 'probe', now);
at(200); m.set_iface_hotplug_state('wan', 'online'); stability.link_connected('wan', m.stability_opts('wan'), false, now);
at(210); stability.quality_write('wan', { fast: 1.5 }); stability.link_quality_changed('wan', now);
at(220);

let status = m.get_status({ section: 'interfaces' });
let wan = status.interfaces.wan, wanb = status.interfaces.wanb;
print('wan health_state: ' + wan.health_state + ' status: ' + wan.status + '\n');
print('wan held: ' + sprintf('%J', wan.held) + '\n');
print('wan flaps: ' + sprintf('%J', wan.flaps) + '\n');
print('wan availability: ' + sprintf('%J', wan.availability) + '\n');
print('wan degraded_for: ' + sprintf('%J', wan.degraded_for) + '\n');
print('wanb flaps: ' + sprintf('%J', wanb.flaps) + ' held: ' + wanb.held.active + ' degraded_for: ' + sprintf('%J', wanb.degraded_for) + '\n');

print('\nlink_history method: ' + (exists(rpcd, 'link_history') ? 'yes' : 'no') + '\n');
let all = rpcd.link_history.call({ args: {} });
print('ok: ' + all.ok + ' interfaces: ' + join(',', sort(keys(all.interfaces))) + '\n');
let one = rpcd.link_history.call({ args: { interface: 'wan' } }).interfaces.wan;
print('keys: ' + join(',', sort(keys(one))) + '\n');
for (let e in one.events)
	print(sprintf('  %d %s %s\n', e.time, e.state, e.reason));
print('since 1000150: ' + join(',', map(rpcd.link_history.call({ args: { interface: 'wan', since: 1000150 } }).interfaces.wan.events, e => e.state)) + '\n');
print('limit 2: ' + join(',', map(rpcd.link_history.call({ args: { interface: 'wan', limit: 2 } }).interfaces.wan.events, e => e.state)) + '\n');
print('unknown interface: ' + sprintf('%J', rpcd.link_history.call({ args: { interface: 'nope' } })) + '\n');

let caps = rpcd.capabilities.call({ args: {} }).stability;
print('\ncapabilities: link_history=' + caps.link_history + ' defaults=' + sprintf('%J', caps.defaults) + '\n');

print('\ninterfaces report:\n');
global.system = cmd => 0;
for (let line in m.report_iface_status())
	print(replace(line, /^ interface (\w+).*, ([0-9]+ active connections)/, '$1: $2') + '\n');
-- End --

