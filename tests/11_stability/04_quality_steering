-- Testcase --
import m from 'mwan4';
import stability from 'stability';
m.set_scriptname('test');
m.init();
m.update_iface_to_table();

let now = 1000000;
global.time = () => now;
let at = t => { now = 1000000 + t; };

function chains() {
	m.rebuild_dynamic();
	m.nft_file('install', 'dynamic');
	let lines = split(global.mocklib.read_captured('/usr/share/nftables.d/ruleset-post/10-mwan4.nft'), '\n');
	let current = null, out = {};
	for (let l in lines) {
		let c = match(l, /^\tchain mwan4_strategy_(\w+)_ipv4 \{/);
		if (c) { current = c[1]; out[current] = []; }
		else if (current && l == '\t}') current = null;
		else if (current) push(out[current], replace(replace(l, /.*comment "([^"]*)".*/, '$1'), /^\t+/, ''));
	}
	return join('  ', map(sort(keys(out)), k => k + '=' + split(out[k][0], ' ')[0]));
}

m.set_iface_hotplug_state('wan', 'online');
m.set_iface_hotplug_state('wanb', 'online');

let limits = m.quality_limits('wan');
print('limits of wan: ' + join(', ', map(limits, l => sprintf('%s(lat=%s loss=%s)', l.strategy, l.max_latency, l.max_loss))) + '\n');
print('limits of wanb: ' + join(', ', map(m.quality_limits('wanb'), l => l.strategy)) + '\n');

let state = stability.quality_state();
let hold = m.stability_opts('wan').quality_hold;
let cycle = (t, latency, loss) => {
	at(t);
	let changed = stability.quality_step(state, { latency, loss }, limits, hold, now);
	if (changed) stability.quality_write('wan', state.degraded);
	print(sprintf('t=%-4d lat=%-4s loss=%-3d changed=%-5s degraded=%s  %s\n', t, latency, loss, changed, join(',', sort(keys(state.degraded))), chains()));
};

print('\n-- smoothing: a window of three samples is needed and a spike averaged below the limit does not degrade\n');
cycle(0, 20, 0); cycle(5, 20, 0); cycle(10, 250, 0); cycle(15, 20, 0); cycle(20, 20, 0);
print('\n-- sustained latency\n');
cycle(25, 300, 0); cycle(30, 300, 0); cycle(35, 300, 0);
print('\n-- unchanged set: no rebuild signal\n');
cycle(40, 310, 0);
print('\n-- loss joins\n');
cycle(45, 300, 40); cycle(50, 300, 40);
print('\n-- recovery needs <80% of the limit for quality_hold seconds\n');
cycle(55, 90, 0); cycle(60, 90, 0); cycle(65, 90, 0); cycle(70, 70, 0); cycle(75, 70, 0);
cycle(80, 70, 0);
print('now ' + now + ', below since ' + sprintf('%J', state.below) + '\n');
cycle(105, 70, 0);
cycle(106, 70, 0);
cycle(120, 70, 0);
print('\n-- a bounce above 80% restarts the hold\n');
cycle(125, 400, 0); cycle(130, 400, 0); cycle(135, 400, 0);
cycle(140, 70, 0); cycle(145, 70, 0); cycle(150, 70, 0); cycle(155, 85, 0); cycle(160, 85, 0); cycle(165, 85, 0);
print('state after bounce: ' + sprintf('%J', state.below) + '\n');

print('\n-- all candidates degraded: least bad stays, never an empty strategy\n');
m.set_iface_hotplug_state('wanb', 'offline');
print('wanb offline: ' + chains() + '\n');
m.set_iface_hotplug_state('wanb', 'online');
stability.quality_write('wanb', { fast: 3.5, clean: 1.2 });
stability.quality_write('wan', { fast: 2.0, clean: 9.0 });
print('both degraded: ' + chains() + '\n');
print('status degraded_for wan: ' + join(',', m.link_stability('wan', [])['degraded_for']) + '\n');
stability.quality_clear('wan');
print('wan restored: ' + chains() + '\n');

print('\n-- sample building\n');
print(sprintf('%J\n', stability.quality_sample([{ result: 0, latency: 20, loss: 0 }, { result: 0, latency: 40, loss: 50 }])));
print(sprintf('%J\n', stability.quality_sample([{ result: 1, latency: 999999, loss: 100 }, { result: 0, latency: 30, loss: null }])));
print(sprintf('%J\n', stability.quality_sample([{ result: 1, latency: 999999, loss: 100 }])));
-- End --

