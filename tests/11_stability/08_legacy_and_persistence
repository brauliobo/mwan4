Testing that flap_damping 0 with recovery_hold 0 keeps the immediate failback of older releases and that the link history survives a stop/start.

-- File uci/mwan4.json --
{
	"globals": [{ ".name": "globals", "mmx_mask": "0x3F00", "flap_damping": "0", "recovery_hold": "0" }],
	"interface": [
		{ ".name": "wan", "enabled": "1", "id": "1", "table_id": "1", "mark": "0x100", "family": ["ipv4"] }
	]
}
-- End --

-- Testcase --
import m from 'mwan4';
import stability from 'stability';
m.set_scriptname('test');
m.init();

let now = 1000000;
global.time = () => now;

stability.link_connected('wan', m.stability_opts('wan'), true, now);
for (let i = 1; i <= 6; i++) {
	now += 5; stability.link_disconnected('wan', 'probe', now);
	now += 5; stability.link_connected('wan', m.stability_opts('wan'), false, now);
	print('flap ' + i + ' held: ' + stability.held_info('wan', now).active + '\n');
}
print('flaps counted: ' + sprintf('%J', stability.history_flaps(stability.history_events('wan'), 300, now)) + '\n');

let calls = [];
global.system = cmd => { push(calls, cmd); return 0; };
stability.history_stash();
stability.history_restore();
print(join('\n', calls) + '\n');
-- End --

-- Expect stdout --
flap 1 held: false
flap 2 held: false
flap 3 held: false
flap 4 held: false
flap 5 held: false
flap 6 held: false
flaps counted: { "count_window": 6, "total": 6 }
rm -rf '/var/run/mwan4.history'; mv '/var/run/mwan4/history' '/var/run/mwan4.history' 2>/dev/null
[ -d '/var/run/mwan4.history' ] && mv '/var/run/mwan4.history' '/var/run/mwan4/history'
-- End --
