-- Testcase --
import m from 'mwan4';
m.set_scriptname('test');
m.init();

let validation = m.validate_config();
print('valid: ' + validation.valid + '\n');
for (let e in validation.errors)
	print('error ' + e.code + ' ' + e.section + ': ' + e.message + '\n');
for (let w in validation.warnings)
	print('warning ' + w.code + ' ' + (w.section ?? '-') + ': ' + w.message + '\n');

let wan = m.stability_opts('wan'), wanb = m.stability_opts('wanb');
print(sprintf('\nwan (invalid values fall back to the global/default): %J\n', wan));
print(sprintf('wanb: %J\n', wanb));
-- End --

