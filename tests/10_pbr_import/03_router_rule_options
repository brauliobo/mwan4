-- Testcase --
import m from 'mwan4';
import importer from 'pbr_import';

function dump_sections(stype) {
	let c = require('uci').cursor();
	c.load('mwan4');
	let lines = [];
	c.foreach('mwan4', stype, s => push(lines, s));
	return lines;
}

function dump_options(section) {
	let keys_ = sort(filter(keys(section), k => index(k, '.') != 0));
	return join(' ', map(keys_, k => k + '=' + (type(section[k]) == 'array' ? '[' + join(',', section[k]) + ']' : section[k])));
}

m.set_scriptname('test');
m.init();
importer.pbr_import({ apply: true });

let rules = {};
for (let r in dump_sections('rule')) rules[r['.name']] = r;
for (let name in ['youtube', 'discord_voi', 'cloudflare', 'meta_quest', 'jitsi_1', 'jitsi_2', 'google_me_2_1', 'google_me_2_2', 'google_me_3_1', 'mc_wan2', 'hcaptcha'])
	print(name + ': ' + dump_options(rules[name]) + '\n');
