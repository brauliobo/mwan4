-- Testcase --
import m from 'mwan4';
import importer from 'pbr_import';

m.set_scriptname('test');
m.init();

let result = importer.pbr_import({});
for (let p in result.policies) {
	printf('%s: %s %s\n', p.name, p.action, p.action == 'skip' ? p.reason : join(',', p.rules) + ' -> ' + p.strategy);
	if (p.summary) printf('  %s\n', p.summary);
}
print('interfaces: ' + join(',', result.interfaces) + '\n');
print('strategies: ' + join(',', result.strategies) + '\n');
-- End --

