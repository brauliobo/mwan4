-- Testcase --
import m from 'mwan4';
import importer from 'pbr_import';

function dump_sections(stype) {
	let c = require('uci').cursor();
	c.load('mwan4');
	let lines = [];
	c.foreach('mwan4', stype, s => push(lines, s));
	return lines;
}

function dump_options(section) {
	let keys_ = sort(filter(keys(section), k => index(k, '.') != 0));
	return join(' ', map(keys_, k => k + '=' + (type(section[k]) == 'array' ? '[' + join(',', section[k]) + ']' : section[k])));
}

m.set_scriptname('test');
m.init();

let preview = importer.pbr_import({});
print('applied: ' + preview.applied + '\n');
for (let p in preview.policies)
	printf('%-30s %-6s %-3s %-26s %s\n', p.name, p.action, p.enabled ? 'on' : 'off', join(',', p.rules), p.strategy);
print('interfaces: ' + join(',', preview.interfaces) + '\n');
print('strategies: ' + join(',', preview.strategies) + '\n');
for (let w in preview.warnings)
	print('warning: ' + w + '\n');
print('backup written: ' + global.mocklib.has_captured('/etc/config/mwan4.pre-pbr-import') + '\n');
print('rules committed: ' + length(dump_sections('rule')) + '\n');
-- End --

