import m from 'mwan4';
import importer from 'pbr_import';

function dump_sections(stype) {
	let c = require('uci').cursor();
	c.load('mwan4');
	let lines = [];
	c.foreach('mwan4', stype, s => push(lines, s));
	return lines;
}

function dump_options(section) {
	let keys_ = sort(filter(keys(section), k => index(k, '.') != 0));
	return join(' ', map(keys_, k => k + '=' + (type(section[k]) == 'array' ? '[' + join(',', section[k]) + ']' : section[k])));
}

m.set_scriptname('test');
m.init();

let first = importer.pbr_import({ apply: true });
print('applied: ' + first.applied + '\n');
print('backup: ' + global.mocklib.read_captured('/etc/config/mwan4.pre-pbr-import'));

let rules = dump_sections('rule');
print('rules: ' + length(rules) + '\n');
print('first: ' + rules[0]['.name'] + '\n');
print('last two: ' + join(',', map(slice(rules, -2), r => r['.name'])) + '\n');
for (let r in rules)
	printf('%-16s enabled=%s strategy=%s\n', r['.name'], r.enabled, r.use_strategy);

for (let iface in dump_sections('interface'))
	if (iface.pbr_import)
		print('interface ' + iface['.name'] + ': ' + dump_options(iface) + '\n');
for (let st in dump_sections('strategy'))
	print('strategy ' + st['.name'] + ': ' + dump_options(st) + '\n');
for (let r in dump_sections('route'))
	if (r.pbr_import)
		print('route ' + r['.name'] + ': ' + dump_options(r) + '\n');

m.reload();
let validation = m.validate_config();
print('valid: ' + validation.valid + ' errors: ' + length(validation.errors) + '\n');

let sections_before = length(dump_sections(null));
let second = importer.pbr_import({ apply: true });
print('idempotent sections: ' + (length(dump_sections(null)) == sections_before) + '\n');
print('idempotent rules: ' + (join(',', map(dump_sections('rule'), r => r['.name'])) == join(',', map(rules, r => r['.name']))) + '\n');
print('second interfaces created: ' + length(second.interfaces) + '\n');
-- End --

