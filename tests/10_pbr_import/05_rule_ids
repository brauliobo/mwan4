-- Testcase --
import m from 'mwan4';
import importer from 'pbr_import';

m.set_scriptname('test');
m.init();

let rule_ids = () => {
	let c = require('uci').cursor();
	c.load('mwan4');
	let ids = [];
	c.foreach('mwan4', 'rule', s => push(ids, s['.name'] + '=' + (s.rule_id ?? '-')));
	return join(' ', ids);
};

importer.pbr_import({ apply: true });
let first = rule_ids();
print('first import: ' + first + '\n');

importer.pbr_import({ apply: true });
print('second import identical: ' + (rule_ids() == first) + '\n');

let c = require('uci').cursor();
c.load('mwan4');
c.set('mwan4', 'web', 'rule_id', '40');
c.commit('mwan4');
importer.pbr_import({ apply: true });
print('custom id kept on re-import: ' + rule_ids() + '\n');
-- End --

-- Expect stdout --
first import: keeper=2 web=1 dns_1=3 dns_2=4 voice=5 default_rule_v4=- default_rule_v6=-
second import identical: true
custom id kept on re-import: keeper=2 web=40 dns_1=3 dns_2=4 voice=5 default_rule_v4=- default_rule_v6=-
-- End --
