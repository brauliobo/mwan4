# start on a fresh system
start
  ucode init_setup.uc
  instance rtmon_ipv4
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4rtmon.uc ipv4
    respawn 
  instance rtmon_ipv6
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4rtmon.uc ipv6
    respawn 
# restart of a running service
reload
start
  lock
  ucode init_reload.uc
  instance track_wan_ipv4
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4track.uc wan ipv4 aa11
    respawn 
  instance track_wan_ipv6
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4track.uc wan ipv6 aa11
    respawn 
  instance track_wanb_ipv4
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4track.uc wanb ipv4 bb22
    respawn 
  instance rtmon_ipv4
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4rtmon.uc ipv4
    respawn 
  instance rtmon_ipv6
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4rtmon.uc ipv6
    respawn 
# reload (config commit)
reload
start
  lock
  ucode init_reload.uc
  instance track_wan_ipv4
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4track.uc wan ipv4 aa11
    respawn 
  instance track_wan_ipv6
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4track.uc wan ipv6 aa11
    respawn 
  instance track_wanb_ipv4
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4track.uc wanb ipv4 bb22
    respawn 
  instance rtmon_ipv4
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4rtmon.uc ipv4
    respawn 
  instance rtmon_ipv6
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4rtmon.uc ipv6
    respawn 
# start of a running service
start
  lock
  ucode init_reload.uc
  instance track_wan_ipv4
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4track.uc wan ipv4 aa11
    respawn 
  instance track_wan_ipv6
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4track.uc wan ipv6 aa11
    respawn 
  instance track_wanb_ipv4
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4track.uc wanb ipv4 bb22
    respawn 
  instance rtmon_ipv4
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4rtmon.uc ipv4
    respawn 
  instance rtmon_ipv6
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4rtmon.uc ipv6
    respawn 
# reload rejected by the validation
reload
start
  lock
  ucode init_reload.uc
  logger -t mwan4 -p daemon.err configuration rejected, keeping the running state
  instance track_wan_ipv4
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4track.uc wan ipv4 aa11
    respawn 
  instance track_wan_ipv6
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4track.uc wan ipv6 aa11
    respawn 
  instance track_wanb_ipv4
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4track.uc wanb ipv4 bb22
    respawn 
  instance rtmon_ipv4
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4rtmon.uc ipv4
    respawn 
  instance rtmon_ipv6
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4rtmon.uc ipv6
    respawn 
# stop
stop
  ucode init_teardown.uc
  config changed: firewall
# restart of a stopped service
start
  ucode init_setup.uc
  instance rtmon_ipv4
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4rtmon.uc ipv4
    respawn 
  instance rtmon_ipv6
    command ucode -S -L /lib/mwan4 /lib/mwan4/mwan4rtmon.uc ipv6
    respawn 
