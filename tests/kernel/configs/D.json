{
 "globals": [
  {".name": "globals", "mmx_mask": "0x3F00", "rule_mask": "0x00fc0000", "source_routing": "0"}
 ],
 "interface": [
  {".name": "wan", "enabled": "1", "id": "1", "table_id": "1", "mark": "0x100", "track_ip": ["1.1.1.1"], "family": ["ipv4"], "reliability": "1", "initial_state": "offline"},
  {".name": "wanc", "enabled": "1", "id": "3", "table_id": "3", "mark": "0x300", "track_ip": ["1.0.0.1"], "family": ["ipv4"], "reliability": "1"}
 ],
 "route": [
  {".name": "wan_m1", "interface": "wan", "metric": "1", "weight": "1"},
  {".name": "wanc_m2", "interface": "wanc", "metric": "2", "weight": "1"}
 ],
 "strategy": [
  {".name": "failover", "use_route": ["wan_m1", "wanc_m2"]},
  {".name": "wanb_only", "use_route": ["wan_m1"]},
  {".name": "new_strat", "use_route": ["wanc_m2", "wan_m1"]}
 ],
 "rule": [
  {".name": "r_new", "domain": ["new.example.net", "example.com"], "use_strategy": "new_strat", "family": ["ipv4"]},
  {".name": "r_dom", "domain": ["example.com"], "use_strategy": "failover", "family": ["ipv4"]},
  {".name": "r_src", "src_ip": ["10.9.0.0/24"], "use_strategy": "wanb_only", "family": ["ipv4"], "sticky": "1", "timeout": "300"},
  {".name": "default_rule_v4", "dest_ip": "0.0.0.0/0", "use_strategy": "failover", "family": ["ipv4"]}
 ]
}
