Testing the hand-over of a stop to the following start: tracker verdicts and holds of interfaces that still exist and are up are stashed and put back when the stash is young enough; stale stashes and interfaces that are gone or down are ignored.

-- File uci/mwan4.json --
{
	"globals": [{ ".name": "globals", "mmx_mask": "0x3F00" }],
	"interface": [
		{ ".name": "wan", "enabled": "1", "id": "1", "table_id": "1", "mark": "0x100", "family": ["ipv4", "ipv6"], "track_ip": ["1.1.1.1"] },
		{ ".name": "wanb", "enabled": "1", "id": "2", "table_id": "2", "mark": "0x200", "family": ["ipv4"], "track_ip": ["8.8.8.8"] },
		{ ".name": "wanc", "enabled": "0", "id": "3", "table_id": "3", "mark": "0x300", "family": ["ipv4"], "track_ip": ["8.8.4.4"] }
	]
}
-- End --

-- File ubus/network.interface.wanb~status.json --
