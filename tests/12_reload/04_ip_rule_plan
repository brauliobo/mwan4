-- Testcase --
import m from 'mwan4';
import reconcile from 'reconcile';

for (let line in [
	'1001:\tfrom all iif eth9 lookup 1',
	'2061:\tfrom all fwmark 0x3d00/0x3f00 blackhole',
	'2001:\tfrom all fwmark 0x100 lookup 1 proto static',
	'3001:\tfrom all fwmark 0x100/0x3f00 unreachable',
	'0:\tfrom all lookup local',
	'100:\tfrom 10.0.0.0/8 lookup 5',
]) {
	let r = reconcile.parse_rule(line);
	print(sprintf('%-52s -> %s\n', line, r ? reconcile.rule_key(r) : 'ignored'));
}

let owned = { '1001': true, '2001': true, '3001': true };
let wanted = [
	{ pref: 1001, iif: 'eth0', action: 'lookup 1' },
	{ pref: 2001, fwmark: { value: 0x100, mask: 0x3f00 }, action: 'lookup 1' },
	{ pref: 3001, fwmark: { value: 0x100, mask: 0x3f00 }, action: 'unreachable' },
];
let plan = reconcile.plan_rules(map([
	'1001:\tfrom all iif eth9 lookup 1',
	'2001:\tfrom all fwmark 0x100/0x3f00 lookup 1',
	'2002:\tfrom all fwmark 0x200/0x3f00 lookup 2',
	'32766:\tfrom all lookup main',
], x => x), wanted, owned);
print('add: ' + join(' ; ', map(plan.add, reconcile.rule_key)) + '\n');
print('del: ' + join(' ; ', map(plan.del, reconcile.rule_key)) + '\n');

plan = reconcile.plan_rules(['1001:\tfrom all iif eth0 lookup 1'], wanted, owned);
print('already there: add ' + length(plan.add) + ', del ' + length(plan.del) + '\n');

// Through the module: the interface moved from eth9 to eth0
m.set_scriptname('test');
m.init();
let cmds = [];
global.system = cmd => { if (index(cmd, 'logger') != 0) push(cmds, cmd); return 0; };

m.create_iface_rules('wan', 'eth0');
print(join('\n', cmds) + '\n');

cmds = [];
print('-- ifdown\n');
m.delete_iface_rules('wan');
print(join('\n', cmds) + '\n');
-- End --

