Testing that the sets are only staged for the generated files when the ruleset is swapped atomically, while the cold start and the route monitor still load them right away.

-- File uci/mwan4.json --
{
	"globals": [{ ".name": "globals", "mmx_mask": "0x3F00" }],
	"interface": [
		{ ".name": "wan", "enabled": "1", "id": "1", "table_id": "1", "mark": "0x100", "family": ["ipv4"] }
	]
}
-- End --

-- Testcase --
let fs = require('fs');
let ubus = require('ubus');
let connect = ubus.connect;
ubus.connect = () => {
	let conn = connect();
	let call = conn.call;
	conn.call = (object, method, args) => match(object, /_[46]$/) ? null : call(object, method, args);
	return conn;
};

let loaded = [];
let popen = fs.popen;
fs.popen = (cmd, mode) => {
	if (index(cmd, 'nft -f ') == 0) push(loaded, split(cmd, ' ')[2]);
	return popen(cmd, mode);
};

import m from 'mwan4';
m.set_scriptname('test');
m.init();

function generate(title, staged) {
	loaded = [];
	m.generate_nft(m.collect_user_rules(), staged);
	let lines = m.nft_file('lines');
	print(title + ': ' + length(loaded) + ' live loads, ' + length(filter(lines, l => match(l, /^\tset mwan4_(connected|custom|dynamic)_ipv4 \{/))) + ' ipv4 base sets declared\n');
}

generate('swap (staged)', true);
generate('cold start', false);

loaded = [];
m.set_connected_ipv4();
print('route monitor refresh: ' + length(loaded) + ' live load\n');
loaded = [];
m.set_connected_ipv4(true);
print('staged refresh: ' + length(loaded) + ' live loads\n');
-- End --

-- Expect stdout --
swap (staged): 0 live loads, 6 ipv4 base sets declared
cold start: 4 live loads, 6 ipv4 base sets declared
route monitor refresh: 1 live load
staged refresh: 0 live loads
-- End --
