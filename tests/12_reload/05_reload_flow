-- Testcase --
let fs = require('fs');
let ubus = require('ubus');

// Interfaces named like wan_4 do not exist; answer that without the mock's missing fixture notice.
let connect = ubus.connect;
ubus.connect = () => {
	let conn = connect();
	let call = conn.call;
	conn.call = (object, method, args) => match(object, /_[46]$/) ? null : call(object, method, args);
	return conn;
};

let log = [], live_listing = '', transaction;
let popen = fs.popen;
fs.popen = (cmd, mode) => {
	push(log, cmd);
	if (index(cmd, 'nft -t list table') == 0)
		return { read: () => live_listing, close: () => 0 };
	if (index(cmd, 'nft -f ') == 0)
		transaction = global.mocklib.read_captured(split(cmd, ' ')[2]);
	return popen(cmd, mode);
};
global.system = cmd => { if (index(cmd, 'logger') != 0) push(log, cmd); return 0; };

import m from 'mwan4';
import reconcile from 'reconcile';

// What the previous setup left behind: states, applied record, live nft objects, installed tracker list.
function previous_apply() {
	m.update_iface_to_table();
	for (let iface in ['wan', 'wanb', 'wanc', 'wan4'])
		m.set_iface_hotplug_state(iface, 'online');
	let rules = m.collect_user_rules();
	m.generate_nft(rules, true);
	m.sync_dnsmasq(rules);
	m.record_applied(rules);
	m.persist_policy_ownership();

	let live = reconcile.declarations(m.nft_file('lines'));
	live_listing = join('\n', map(['chain', 'set', 'map', 'counter'], kind => join('\n', map(keys(live[kind]), name => '\t' + kind + ' ' + name + ' {'))));
}

m.set_scriptname('test');
m.init();
previous_apply();
print('trackers before:\n' + global.mocklib.read_captured('/var/run/mwan4/trackers'));

// The configuration changes: wanb tracks another target, rule "old" is replaced by "fresh", wan4 is removed
function edit(change) {
	let c = require('uci').cursor();
	c.load('mwan4');
	let config = c.get_all('mwan4');
	change(config);
	global.mocklib.uci_store.mwan4 = config;
}
edit(config => {
	config.wanb.track_ip = ['9.9.9.9'];
	delete config.wan4;
	delete config.old;
	config.fresh = { '.name': 'fresh', '.type': 'rule', '.index': 99, domain: ['fresh.example.net'], use_strategy: 'failover', family: ['ipv4'] };
});

m.reload();
m.init(null, true);
log = [];
print('reload ok: ' + m.reload_running() + '\n');

let interesting = filter(log, c => match(c, /^(ip -[46] (rule (add|del)|route flush)|nft (-c )?-f|fw4|conntrack|\/etc\/init\.d|ucode|\(flock)/));
print(join('\n', map(interesting, c => replace(c, /for d in .*; do/, 'for d in ...; do'))) + '\n');
print('prefetch only the new domain: ' + (length(filter(log, c => index(c, "'fresh.example.net'") >= 0 && index(c, 'media.example.com') < 0)) == 1) + '\n');

let verbs = filter(split(transaction, '\n'), l => match(l, /^(flush|delete) /));
print('-- transaction\n' + join('\n', verbs) + '\n');
print('-- trackers after\n' + global.mocklib.read_captured('/var/run/mwan4/trackers'));
print('persisted rules file has the new domain set: ' + (index(global.mocklib.read_captured('/usr/share/nftables.d/ruleset-post/11-mwan4-rules.nft'), 'mwan4_dom_fresh_ipv4') >= 0) + '\n');
print('policy ownership kept: ' + trim(global.mocklib.read_captured('/var/run/mwan4/mwan4.rule_prefs')) + '\n');
print('wanc state: ' + m.get_iface_hotplug_state('wanc') + '\n');
print('-- dnsmasq\n' + global.mocklib.read_captured('/tmp/dnsmasq.main.d/mwan4.conf'));
-- End --

