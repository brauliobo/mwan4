Testing the guard rail of a reload: when the nft transaction does not validate nothing live changes (no ip rule, no nft -f, no installed include, no new tracker list) and the failure is reported; the hotplug apply is rejected the same way.

-- File uci/mwan4.json --
{
	"globals": [{ ".name": "globals", "mmx_mask": "0x3F00", "rule_mask": "0x00fc0000" }],
	"interface": [
		{ ".name": "wan", "enabled": "1", "id": "1", "table_id": "1", "mark": "0x100", "family": ["ipv4"], "track_ip": ["1.1.1.1"] },
		{ ".name": "wanb", "enabled": "1", "id": "2", "table_id": "2", "mark": "0x200", "family": ["ipv4"], "track_ip": ["8.8.8.8"] }
	],
	"route": [{ ".name": "wan_m1", "interface": "wan", "metric": "1", "weight": "1" }],
	"strategy": [{ ".name": "failover", "use_route": ["wan_m1"] }]
}
-- End --

