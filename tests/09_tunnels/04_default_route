	"globals": [{ ".name": "globals", "mmx_mask": "0x3F00" }],
	"interface": [
		{ ".name": "wan", "enabled": "1", "id": "1", "table_id": "1", "mark": "0x100", "family": ["ipv4"] },
		{ ".name": "tun0", "enabled": "1", "id": "2", "table_id": "2", "mark": "0x200", "family": ["ipv4", "ipv6"], "type": "tunnel", "default_route": "1" },
		{ ".name": "vpn", "enabled": "1", "id": "3", "table_id": "3", "mark": "0x300", "family": ["ipv4"], "default_route": "1" },
		{ ".name": "gre0", "enabled": "1", "id": "4", "table_id": "4", "mark": "0x400", "family": ["ipv6"], "type": "tunnel" }
	]
}
-- End --

