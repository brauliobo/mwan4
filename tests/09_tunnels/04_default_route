{ "up": true, "l3_device": "gre0", "device": "gre0" }
-- End --

-- Testcase --
import m from 'mwan4';
m.set_scriptname('test');
m.init();

let calls = [];
global.system = (cmd) => { push(calls, cmd); return 0; };

for (let iface in ['wan', 'tun0', 'vpn', 'gre0'])
	print(iface + ' needs default route: ' + m.needs_default_route(iface) + '\n');

for (let iface in ['wan', 'tun0', 'vpn', 'gre0']) {
	calls = [];
	m.create_iface_route(iface);
	print(iface + ': ' + join(' | ', filter(calls, c => index(c, 'default dev') >= 0)) + '\n');
}
-- End --

-- Expect stdout --
wan needs default route: false
tun0 needs default route: true
vpn needs default route: true
gre0 needs default route: true
wan: 
tun0: ip -4 route replace table 2 default dev 'wg0' >/dev/null 2>&1 | ip -6 route replace table 2 default dev 'wg0' >/dev/null 2>&1
vpn: ip -4 route replace table 3 default dev 'tun1' >/dev/null 2>&1
gre0: ip -6 route replace table 4 default dev 'gre0' >/dev/null 2>&1
-- End --
