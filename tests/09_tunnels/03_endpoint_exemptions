-- Testcase --
import m from 'mwan4';

m.set_scriptname('test');
m.load();

let tunnels = m.get_diagnostics({ section: 'tunnels' }).diagnostics.tunnels;
let exemption = tunnels.exemptions.tun0;
print('exemption endpoint: ' + exemption.endpoint + '\n');
print('exemption underlay: ' + exemption.underlay + '\n');
print('exemption command: ' + exemption.command + '\n');

let calls = [];
global.system = function(command) {
	push(calls, command);
	return 0;
};

let result = m.advanced_control({ action: 'apply_tunnel_exemptions', interface: 'tun0' });
print('apply ok: ' + result.ok + '\n');
print('applied count: ' + length(result.applied) + '\n');
print('calls: ' + join('|', calls) + '\n');
-- End --

