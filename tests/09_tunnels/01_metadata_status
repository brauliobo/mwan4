-- Testcase --
import m from 'mwan4';

m.set_scriptname('test');
m.load();

let meta = m.get_tunnel_metadata('tun0');
print('type: ' + meta.type + '\n');
print('transport_type: ' + meta.transport_type + '\n');
print('underlay_strategy: ' + meta.underlay_strategy + '\n');
print('endpoint_fail_mode: ' + meta.endpoint_fail_mode + '\n');
print('data_fail_mode: ' + meta.data_fail_mode + '\n');
print('prevent_recursion: ' + meta.prevent_recursion + '\n');

let status = m.get_tunnel_status();
let tun0 = status.interfaces.tun0;
print('tunnel interfaces: ' + join(',', keys(status.interfaces)) + '\n');
print('underlay interfaces: ' + join(',', tun0.underlay_interfaces) + '\n');
print('warnings: ' + length(status.warnings) + '\n');

let diagnostics = m.get_diagnostics({ section: 'tunnels' });
print('diagnostic type: ' + diagnostics.diagnostics.tunnels.interfaces.tun0.type + '\n');
-- End --

