-- Testcase --
let methods = require('rpcd_mwan4').mwan4;

print('pbr_import exposed: ' + exists(methods, 'pbr_import') + '\n');
print('apply arg type: ' + type(methods.pbr_import.args.apply) + '\n');

print('rules before: ' + methods.validate.call({ args: {} }).counts.rules + '\n');

let preview = methods.pbr_import.call({ args: {} });
print('preview ok=' + preview.ok + ' applied=' + preview.applied + ' interfaces=' + join(',', preview.interfaces) + ' strategies=' + join(',', preview.strategies) + '\n');
print('rules after preview: ' + methods.validate.call({ args: {} }).counts.rules + '\n');
for (let p in preview.policies)
	print(p.name + ' ' + p.action + ' ' + join(',', p.rules) + ' ' + p.target + ' -> ' + p.strategy + ' | ' + p.summary + '\n');
for (let w in preview.warnings)
	print('warning: ' + w + '\n');

let applied = methods.pbr_import.call({ args: { apply: true } });
print('applied=' + applied.applied + '\n');
let validation = methods.validate.call({ args: {} });
print('rules after apply: ' + validation.counts.rules + ' strategies: ' + validation.counts.strategies + ' interfaces: ' + validation.counts.interfaces + ' valid: ' + validation.valid + '\n');
-- End --

