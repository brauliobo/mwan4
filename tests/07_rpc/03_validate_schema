-- Testcase --
import m from 'mwan4';

m.set_scriptname('test');
m.load();

function has_code(validation, code) {
	for (let error in validation.errors)
		if (error.code == code)
			return 'yes';
	return 'no';
}

let validation = m.validate_config();
print('valid: ' + validation.valid + '\n');
for (let code in [
	'duplicateInterfaceId',
	'duplicateTableId',
	'duplicateMark',
	'invalidBfdPeer',
	'invalidBfdMinRx',
	'invalidBfdMultiplier',
	'invalidRouteMetric',
	'invalidRouteWeight',
	'invalidStrategyLastResort',
	'invalidRulePortProtocol',
	'invalidRuleSourceAddress',
	'invalidRuleIpset',
	'invalidTunnelTransport',
	'invalidTunnelUnderlayStrategy',
	'invalidTunnelEndpoint',
	'invalidTunnelEndpointPort',
	'invalidTunnelLocalEndpoint',
	'invalidTunnelEndpointFailMode',
	'invalidTunnelDataFailMode'
])
	print(code + ': ' + has_code(validation, code) + '\n');
-- End --

