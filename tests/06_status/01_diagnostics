Testing status diagnostics warn when mwan4 is configured but inactive.

-- Testcase --
import m from 'mwan4';
m.set_scriptname('test');
m.load();

let diagnostics = m.get_status_diagnostics({
	service_instances: {},
	nft_chains:        {
		prerouting: false,
		output:     false,
		rules_ipv4: false,
		rules_ipv6: false,
	},
});

print('configured: ' + diagnostics.configured + '\n');
print('service_running: ' + diagnostics.service_running + '\n');
print('trackers_expected: ' + diagnostics.trackers_expected + '\n');
print('trackers_running: ' + diagnostics.trackers_running + '\n');
print('nft_chains: ' + diagnostics.nft_chains + '\n');

for (let warning in diagnostics.warnings)
	print(warning.code + ': ' + warning.message + ' | ' + warning.action + ' | ' + warning.check + '\n');

for (let step in diagnostics.next_steps)
	print('next ' + step.id + ': ' + step.title + ' | ' + step.command + '\n');
-- End --

