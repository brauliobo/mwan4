	"interface": [
		{
			".name": "wan",
			"enabled": "1",
			"family": ["ipv4"],
			"table_id": "1",
			"mark": "0x100"
		}
	],
	"route": [
		{
			".name": "wan_route",
			"interface": "wan",
			"metric": "1",
			"weight": "1"
		}
	],
