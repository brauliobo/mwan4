-- Testcase --
import m from 'mwan4';
m.set_scriptname('test');
m.load();

let pbr = m.get_diagnostics({ section: 'pbr' }).diagnostics.pbr;
let missing_supported = 0;
let missing_iface = '';
let mark_overlap = 0;
let table_overlap = 0;
let table_overlap_table = 0;
let owned_rule_warned = false;

for (let warning in pbr.warnings) {
	if (warning.code == 'pbrSupportedInterfaceMissing') {
		missing_supported++;
		missing_iface = warning.interface;
	}
	if (warning.code == 'markMaskOverlap')
		mark_overlap++;
	if (warning.code == 'tableOverlap') {
		table_overlap++;
		table_overlap_table = warning.table;
	}
	if (warning.rule && (index(warning.rule, '0x100/0x3f00 lookup 1') >= 0 || index(warning.rule, '0x200/0x3F00 lookup 2') >= 0))
		owned_rule_warned = true;
}

print('warning count: ' + length(pbr.warnings) + '\n');
print('missing supported: ' + missing_supported + ' ' + missing_iface + '\n');
print('mark overlaps: ' + mark_overlap + '\n');
print('table overlaps: ' + table_overlap + ' ' + table_overlap_table + '\n');
print('owned rule warned: ' + owned_rule_warned + '\n');
-- End --

