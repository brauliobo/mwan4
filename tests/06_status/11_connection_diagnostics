-- Testcase --
import m from 'mwan4';
m.set_scriptname('test');
m.init();

let show = (title, data) => print(title + ' ' + replace(sprintf('%.J', data), /\s*\n\s*/g, ' ') + '\n');

let d = m.get_diagnostics({ section: 'connections' }).diagnostics.connections;
show('connections', { accounting: d.accounting, rule_mask: d.rule_mask, rule_capacity: d.rule_capacity, total: d.total, errors: d.errors, warnings: d.warnings });
show('interfaces', d.interfaces);
show('strategies', d.strategies);
show('rule ids', map(keys(d.rules), name => name + '=' + d.rules[name].id));

let counters = m.get_diagnostics({ section: 'counters' }).diagnostics.counters;
show('counter summary', counters.summary);
show('https group', { new: counters.groups.rules.https.new_connections, active: counters.groups.rules.https.active_connections, families: keys(counters.groups.rules.https.families) });
show('torrent group', counters.groups.rules.torrent?.active_connections);

let explain = m.get_diagnostics({ section: 'explain', family: 'ipv4', proto: 'udp', dest_port: '443' }).diagnostics.explain;
for (let r in explain.rules)
	print('explain ' + r.rule + ': id=' + r.rule_id + ' new=' + r.new_connections.total + ' active=' + r.active_connections.total + '\n');

print('summary mask: ' + m.get_diagnostics({ section: 'summary' }).diagnostics.summary.rule_mask + '\n');
for (let line in m.report_rules('ipv4'))
	print(line + '\n');
-- End --

