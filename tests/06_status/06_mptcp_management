-- Testcase --
import m from 'mwan4';

let mocklib = global.mocklib;
let calls = [];

global.system = function(command) {
	push(calls, command);
	return 0;
};

m.set_scriptname('test');
m.load();

let diagnostics = m.get_diagnostics({ section: 'mptcp' }).diagnostics.mptcp;
print('configured: ' + diagnostics.configured + '\n');
print('config endpoints: ' + length(diagnostics.config.endpoints) + '\n');
print('config endpoint address: ' + diagnostics.config.endpoints[0].address + '\n');
print('config endpoint device: ' + diagnostics.config.endpoints[0].device + '\n');
print('config endpoint flags: ' + join(',', diagnostics.config.endpoints[0].flags) + '\n');

let applied = m.apply_mptcp_config();
print('apply ok: ' + applied.ok + '\n');
print('apply sysctl: ' + applied.sysctl + '\n');
print('apply limits: ' + applied.limits + '\n');
print('apply endpoints: ' + length(applied.endpoints) + '\n');
print('sysctl captured: ' + mocklib.read_captured('/proc/sys/net/mptcp/enabled'));
print('managed state: ' + mocklib.read_captured('/var/run/mwan4/mptcp.endpoints'));
print('calls: ' + join('|', calls) + '\n');
-- End --

