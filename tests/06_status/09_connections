-- Testcase --
let rpcd = require('rpcd_mwan4');
let call = (method, args) => rpcd.mwan4[method].call({ args });
let show = (title, data) => print(title + ' ' + replace(sprintf('%.J', data), /\s*\n\s*/g, ' ') + '\n');
let line = c => join(' ', [c.family, c.proto, c.src, c.sport, '>', c.dst, c.dport, c.state || '-', c.timeout, c.packets, c.bytes,
	c.rule || '-', c.rule_label || '-', c.interface, c.strategy]);
let list = (title, args) => {
	let r = call('connections', args);
	print(title + ': ok=' + r.ok + ' total=' + r.total + ' truncated=' + r.truncated + ' accounting=' + r.accounting + '\n');
	for (let c in r.items) print('  ' + line(c) + '\n');
};

let status = call('status', {});
show('rules', status.rules);
show('wan', status.interfaces.wan.active_connections);
show('wan6', status.interfaces.wan6.active_connections);
show('wanb', status.interfaces.wanb.active_connections);
show('balanced v4', status.strategy_status.ipv4.balanced.active_connections);
show('balanced v6', status.strategy_status.ipv6.balanced.active_connections);
show('backup v4', status.strategy_status.ipv4.backup.active_connections);
show('rules section', keys(call('status', { section: 'rules' })));

list('all', {});
show('first item', call('connections', { limit: 1 }).items[0]);
list('rule torrent', { rule: 'torrent' });
list('rule catch-all', { rule: 'default_rule_v4' });
list('interface wanb', { interface: 'wanb' });
list('interface default', { interface: 'default' });
list('strategy backup', { strategy: 'backup' });
list('family ipv6', { family: 'ipv6' });
list('proto udp', { proto: 'udp' });
list('search ip', { search: '205.237' });
list('search label', { search: 'bittorrent' });
list('search ipv6', { search: '2001:4860:4847:400::' });
list('combined', { family: 'ipv4', proto: 'udp', interface: 'wan' });
list('unknown rule', { rule: 'ghost' });
list('page 1', { limit: 2 });
list('page 2', { limit: 2, offset: 2 });
list('past the end', { offset: 50 });
show('limit clamp', [length(call('connections', { limit: 1000000 }).items), length(call('connections', { limit: -5 }).items)]);
-- End --

