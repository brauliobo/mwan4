Testing route explain with address lists, disabled rules and catch-all ordering.

-- File uci/mwan4.json --
{
	"globals": [{ ".name": "globals", "mmx_mask": "0x3F00" }],
	"interface": [
		{ ".name": "wan", "enabled": "1", "id": "1", "table_id": "1", "mark": "0x100", "family": ["ipv4"] }
	],
	"route": [
		{ ".name": "wan_route", "interface": "wan", "metric": "1", "weight": "1" }
	],
	"strategy": [
		{ ".name": "wan_only", "use_route": ["wan_route"] }
	],
	"rule": [
		{ ".name": "default_rule_v4", "dest_ip": "0.0.0.0/0", "use_strategy": "default", "family": ["ipv4"] },
		{ ".name": "off", "enabled": "0", "dest_ip": "198.51.100.0/24", "use_strategy": "default" },
		{ ".name": "listed", "dest_ip": ["192.0.2.0/24", "203.0.113.0/24"], "use_strategy": "wan_only" }
	]
}
-- End --

-- Testcase --
import m from 'mwan4';
m.set_scriptname('test');
m.init();
m.set_iface_hotplug_state('wan', 'online');

for (let dest in ['203.0.113.9', '198.51.100.9', '10.0.0.1']) {
	let explain = m.get_diagnostics({ section: 'explain', dest_ip: dest }).diagnostics.explain;
	print(dest + ': matched=' + explain.matched_rule.rule + ' order=' + join(',', map(explain.rules, r => r.rule)) + '\n');
}
-- End --

-- Expect stdout --
203.0.113.9: matched=listed order=off,listed,default_rule_v4
198.51.100.9: matched=default_rule_v4 order=off,listed,default_rule_v4
10.0.0.1: matched=default_rule_v4 order=off,listed,default_rule_v4
-- End --
