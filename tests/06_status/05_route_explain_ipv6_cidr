-- Testcase --
import m from 'mwan4';
m.set_scriptname('test');
m.init();
m.set_iface_hotplug_state('wan6', 'online');

let inside = m.get_diagnostics({ section: 'explain', dest_ip: '2001:db8:abcd:12::99' }).diagnostics.explain;
let outside = m.get_diagnostics({ section: 'explain', family: 'ipv6', dest_ip: '2001:db8:abce::1' }).diagnostics.explain;

print('inside family: ' + inside.input.family + '\n');
print('inside matched rule: ' + inside.matched_rule.rule + '\n');
print('inside cidr matched: ' + inside.rules[0].checks.dest_ip.matched + '\n');
print('inside strategy: ' + inside.decision.strategy + '\n');
print('inside interface: ' + inside.decision.selected.interface + '\n');
print('inside mark: ' + inside.decision.selected.mark + '\n');
print('outside matched rule: ' + outside.matched_rule.rule + '\n');
print('outside cidr matched: ' + outside.rules[0].checks.dest_ip.matched + '\n');
print('outside default matched: ' + outside.rules[1].checks.dest_ip.matched + '\n');
-- End --

