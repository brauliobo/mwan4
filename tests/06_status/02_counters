let rpcd = require('rpcd_mwan4');

let direct = rpcd.mwan4.counters.call({ args: {} });
let section = rpcd.mwan4.status.call({ args: { section: 'counters' } });
let diagnostics = rpcd.mwan4.diagnostics.call({ args: { section: 'counters' } });
let summary = diagnostics.diagnostics.counters.summary;

print('rpc method bytes: ' + direct.counters.mwan4_counter_rule_default_rule_v4_ipv4.bytes + '\n');
print('rpc status bytes: ' + section.counters.mwan4_counter_strategy_wan_only_ipv4_wan.bytes + '\n');
print('diag counter total: ' + summary.total + '\n');
print('diag counter packets: ' + summary.packets + '\n');
print('diag rule counters: ' + summary.rules + '\n');
print('diag strategy counters: ' + summary.strategies + '\n');
