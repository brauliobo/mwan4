-- Testcase --
import m from 'mwan4';

m.set_scriptname('test');
m.init();

let fresh = () => { let c = require('uci').cursor(); c.load('mwan4'); return c; };
let ids = c => {
	let rules = [];
	c.foreach('mwan4', 'rule', s => push(rules, s['.name'] + '=' + (s.rule_id ?? '-')));
	return join(' ', rules);
};

print('capacity: ' + m.get_capabilities().connections.rule_capacity + ' mask: ' + m.get_capabilities().connections.rule_mask + '\n');
print('before: ' + ids(fresh()) + '\n');

m.ensure_rule_ids();
print('assigned: ' + ids(fresh()) + '\n');

let c = fresh();
print('second pass changes: ' + m.assign_rule_ids(c) + '\n');

// Reordering keeps ids; a deleted rule frees its id, a new rule takes the lowest free one.
c.reorder('mwan4', 'e', 0);
print('reordered changes: ' + m.assign_rule_ids(c) + ' -> ' + ids(c) + '\n');
c.delete('mwan4', 'b');
c.set('mwan4', 'z', 'rule');
c.set('mwan4', 'z', 'use_strategy', 'solo');
print('new rule changes: ' + m.assign_rule_ids(c) + ' -> ' + ids(c) + '\n');
-- End --

