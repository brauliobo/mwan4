-- Testcase --
import m from 'mwan4';
m.set_scriptname('test');
m.init();
m.update_iface_to_table();
m.nft_file('create', 'rules');
m.set_user_rules();
m.nft_file('install', 'rules');
let nft = global.mocklib.read_captured('/usr/share/nftables.d/ruleset-post/11-mwan4-rules.nft');

let chain_lines = name => {
	let out = [], inside = false;
	for (let l in split(nft, '\n')) {
		if (l == '\tchain ' + name + ' {') inside = true;
		else if (inside && l == '\t}') break;
		else if (inside) push(out, l);
	}
	return out;
};

for (let chain in ['mwan4_rules_ipv4', 'mwan4_rules_out_ipv4'])
	print(chain + ':\n' + join('\n', chain_lines(chain)) + '\n');
print('copies meta mark into ct mark: ' + (index(nft, 'ct mark set meta mark') >= 0) + '\n');
-- End --

