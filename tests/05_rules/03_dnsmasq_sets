-- Testcase --
import m from 'mwan4';
import dnsmasq from 'dnsmasq';
m.set_scriptname('test');
m.init();

let calls = [];
global.system = (cmd) => { push(calls, cmd); return 0; };

function step(title, action) {
	calls = [];
	action();
	print('--- ' + title + ' (' + length(calls) + ' commands)\n');
	for (let c in calls) print(c + '\n');
}

let rules = m.collect_user_rules();
step('first sync', () => m.sync_dnsmasq(rules));
print(global.mocklib.read_captured('/tmp/dnsmasq.main.d/mwan4.conf'));
print('same file for custom conf-dir: ' + (global.mocklib.read_captured('/tmp/alt.d/mwan4.conf') == global.mocklib.read_captured('/tmp/dnsmasq.main.d/mwan4.conf')) + '\n');
step('unchanged sync', () => m.sync_dnsmasq(rules));
step('prefetch', () => m.prefetch_domains());
step('no domain rules', () => m.sync_dnsmasq({ ipv4: [], ipv6: [] }));
print('file removed: ' + !global.mocklib.has_captured('/tmp/dnsmasq.main.d/mwan4.conf') + '\n');
step('nothing to remove', () => m.sync_dnsmasq({ ipv4: [], ipv6: [] }));
print('--- shared domains\n');
print(dnsmasq.render([{ domains: ['a.example'], specs: ['4#inet#fw4#s4'] }, { domains: ['a.example', 'b.example'], specs: ['4#inet#fw4#t4', '6#inet#fw4#t6'] }]));
-- End --

