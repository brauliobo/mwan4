import m from 'mwan4';
m.set_scriptname('test');
m.init();
print('wan id: ' + m.get_iface_id('wan') + '\n');
print('wan table: ' + m.get_iface_table_id('wan') + '\n');
print('wan mark: ' + m.get_iface_mark('wan') + '\n');

global.TRACE_CALLS = 'stdout';
m.create_iface_rules('wan', 'eth0');
global.TRACE_CALLS = null;

m.nft_file('create', 'dynamic');
m.rebuild_iface_nftfile();
m.set_iface_hotplug_state('wan', 'online');
m.set_strategies_nftables();
m.nft_file('install', 'dynamic');
print(global.mocklib.read_captured('/usr/share/nftables.d/ruleset-post/10-mwan4.nft'));
